# Absolute path to the extracted OGE Wuhan-1 cropland dataset root.
OGE_FARM_DATASET=/absolute/path/to/89d279976ef74625a1ea00d6cad512c1_farm

OGE_DATABASE_URL=postgresql+psycopg://oge:oge_dev_password@127.0.0.1:55432/oge_rice
