{
  "$defs": {
    "AssetRole": {
      "enum": [
        "data",
        "boundary",
        "mask",
        "metadata",
        "overview"
      ],
      "title": "AssetRole",
      "type": "string"
    },
    "DataQuality": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "$ref": "#/$defs/DataQualityStatus"
        },
        "statement": {
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "reviewed_by": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewed By"
        },
        "reviewed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewed At"
        }
      },
      "required": [
        "status",
        "statement"
      ],
      "title": "DataQuality",
      "type": "object"
    },
    "DataQualityStatus": {
      "enum": [
        "illustrative",
        "unverified",
        "verified"
      ],
      "title": "DataQualityStatus",
      "type": "string"
    },
    "DateRange": {
      "additionalProperties": false,
      "properties": {
        "start_date": {
          "format": "date",
          "title": "Start Date",
          "type": "string"
        },
        "end_date": {
          "format": "date",
          "title": "End Date",
          "type": "string"
        }
      },
      "required": [
        "start_date",
        "end_date"
      ],
      "title": "DateRange",
      "type": "object"
    },
    "MediaType": {
      "enum": [
        "image/tiff; application=geotiff",
        "image/tiff; application=geotiff; profile=cloud-optimized",
        "application/geo+json",
        "application/geopackage+sqlite3",
        "application/json"
      ],
      "title": "MediaType",
      "type": "string"
    },
    "RecordStatus": {
      "enum": [
        "draft",
        "active",
        "superseded",
        "withdrawn"
      ],
      "title": "RecordStatus",
      "type": "string"
    },
    "SourceReference": {
      "additionalProperties": false,
      "properties": {
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "publisher": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Publisher"
        },
        "url": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "publication_year": {
          "anyOf": [
            {
              "maximum": 2100,
              "minimum": 1900,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Publication Year"
        },
        "retrieved_at": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retrieved At"
        }
      },
      "required": [
        "title"
      ],
      "title": "SourceReference",
      "type": "object"
    },
    "SpatialAsset": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Asset Id",
          "type": "string"
        },
        "href": {
          "minLength": 1,
          "title": "Href",
          "type": "string"
        },
        "media_type": {
          "$ref": "#/$defs/MediaType"
        },
        "roles": {
          "items": {
            "$ref": "#/$defs/AssetRole"
          },
          "minItems": 1,
          "title": "Roles",
          "type": "array"
        },
        "crs": {
          "minLength": 1,
          "title": "Crs",
          "type": "string"
        },
        "checksum_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Checksum Sha256"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/SourceReference"
        }
      },
      "required": [
        "asset_id",
        "href",
        "media_type",
        "roles",
        "crs",
        "created_at",
        "source"
      ],
      "title": "SpatialAsset",
      "type": "object"
    },
    "VersionInfo": {
      "additionalProperties": false,
      "properties": {
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "previous": {
          "anyOf": [
            {
              "$ref": "#/$defs/VersionedReference"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "status": {
          "$ref": "#/$defs/RecordStatus"
        },
        "change_reason": {
          "minLength": 1,
          "title": "Change Reason",
          "type": "string"
        },
        "changed_by": {
          "minLength": 1,
          "title": "Changed By",
          "type": "string"
        },
        "changed_at": {
          "format": "date-time",
          "title": "Changed At",
          "type": "string"
        },
        "feedback_id": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Feedback Id"
        }
      },
      "required": [
        "revision",
        "status",
        "change_reason",
        "changed_by",
        "changed_at"
      ],
      "title": "VersionInfo",
      "type": "object"
    },
    "VersionedReference": {
      "additionalProperties": false,
      "properties": {
        "record_id": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Record Id",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        }
      },
      "required": [
        "record_id",
        "revision"
      ],
      "title": "VersionedReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "unit_id": {
      "maxLength": 100,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Unit Id",
      "type": "string"
    },
    "name": {
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "unit_type": {
      "enum": [
        "irrigation_district",
        "management_zone",
        "custom"
      ],
      "title": "Unit Type",
      "type": "string"
    },
    "boundary": {
      "$ref": "#/$defs/SpatialAsset"
    },
    "valid_period": {
      "$ref": "#/$defs/DateRange"
    },
    "root_district": {
      "$ref": "#/$defs/VersionedReference"
    },
    "parent": {
      "anyOf": [
        {
          "$ref": "#/$defs/VersionedReference"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "quality": {
      "$ref": "#/$defs/DataQuality"
    },
    "version": {
      "$ref": "#/$defs/VersionInfo"
    }
  },
  "required": [
    "unit_id",
    "name",
    "unit_type",
    "boundary",
    "valid_period",
    "root_district",
    "quality",
    "version"
  ],
  "title": "ManagementUnit",
  "type": "object"
}
