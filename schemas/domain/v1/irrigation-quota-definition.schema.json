{
  "$defs": {
    "DataQuality": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "$ref": "#/$defs/DataQualityStatus"
        },
        "statement": {
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "reviewed_by": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewed By"
        },
        "reviewed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewed At"
        }
      },
      "required": [
        "status",
        "statement"
      ],
      "title": "DataQuality",
      "type": "object"
    },
    "DataQualityStatus": {
      "enum": [
        "illustrative",
        "unverified",
        "verified"
      ],
      "title": "DataQualityStatus",
      "type": "string"
    },
    "RecordStatus": {
      "enum": [
        "draft",
        "active",
        "superseded",
        "withdrawn"
      ],
      "title": "RecordStatus",
      "type": "string"
    },
    "SourceReference": {
      "additionalProperties": false,
      "properties": {
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "publisher": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Publisher"
        },
        "url": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "publication_year": {
          "anyOf": [
            {
              "maximum": 2100,
              "minimum": 1900,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Publication Year"
        },
        "retrieved_at": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retrieved At"
        }
      },
      "required": [
        "title"
      ],
      "title": "SourceReference",
      "type": "object"
    },
    "VersionInfo": {
      "additionalProperties": false,
      "properties": {
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "previous": {
          "anyOf": [
            {
              "$ref": "#/$defs/VersionedReference"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "status": {
          "$ref": "#/$defs/RecordStatus"
        },
        "change_reason": {
          "minLength": 1,
          "title": "Change Reason",
          "type": "string"
        },
        "changed_by": {
          "minLength": 1,
          "title": "Changed By",
          "type": "string"
        },
        "changed_at": {
          "format": "date-time",
          "title": "Changed At",
          "type": "string"
        },
        "feedback_id": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Feedback Id"
        }
      },
      "required": [
        "revision",
        "status",
        "change_reason",
        "changed_by",
        "changed_at"
      ],
      "title": "VersionInfo",
      "type": "object"
    },
    "VersionedReference": {
      "additionalProperties": false,
      "properties": {
        "record_id": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Record Id",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        }
      },
      "required": [
        "record_id",
        "revision"
      ],
      "title": "VersionedReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "quota_id": {
      "maxLength": 100,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Quota Id",
      "type": "string"
    },
    "crop_code": {
      "const": "rice",
      "title": "Crop Code",
      "type": "string"
    },
    "stage_code": {
      "maxLength": 100,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Stage Code",
      "type": "string"
    },
    "value_m3_per_mu": {
      "exclusiveMinimum": 0,
      "title": "Value M3 Per Mu",
      "type": "number"
    },
    "source": {
      "$ref": "#/$defs/SourceReference"
    },
    "quality": {
      "$ref": "#/$defs/DataQuality"
    },
    "version": {
      "$ref": "#/$defs/VersionInfo"
    }
  },
  "required": [
    "quota_id",
    "crop_code",
    "stage_code",
    "value_m3_per_mu",
    "source",
    "quality",
    "version"
  ],
  "title": "IrrigationQuotaDefinition",
  "type": "object"
}
